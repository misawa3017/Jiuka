rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function ownAccount(uid) {
      return googleUser() && request.auth.uid == uid;
    }

    function trimmedNonEmpty(value) {
      return value is string
        && value == value.trim()
        && value.size() > 0;
    }

    function trimmedString(value) {
      return value is string && value == value.trim();
    }

    function validRecurringEventSettings(settings) {
      return settings == null || (
        settings is map
        && settings.keys().hasAll(['dayOfWeek', 'hour', 'minute'])
        && settings.keys().hasOnly(['dayOfWeek', 'hour', 'minute'])
        && settings.dayOfWeek is int
        && settings.dayOfWeek >= 1
        && settings.dayOfWeek <= 7
        && settings.hour is int
        && settings.hour >= 0
        && settings.hour <= 23
        && settings.minute is int
        && settings.minute >= 0
        && settings.minute <= 59
      );
    }

    match /users/{uid} {
      allow get: if ownAccount(uid);
      allow list: if false;
      allow create: if ownAccount(uid)
        && request.resource.data.keys().hasAll(['name', 'email', 'avatarUrl', 'joinedGroups'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'avatarUrl', 'joinedGroups'])
        && trimmedNonEmpty(request.resource.data.name)
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string)
        && request.resource.data.joinedGroups == [];
      allow update: if ownAccount(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && trimmedNonEmpty(request.resource.data.name);
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow get, list: if googleUser();
      allow create: if googleUser()
        && request.resource.data.keys().hasAll(['name', 'description', 'adminId', 'maxPlayersDefault', 'recurringEventSettings', 'memberIds'])
        && request.resource.data.keys().hasOnly(['name', 'description', 'adminId', 'maxPlayersDefault', 'recurringEventSettings', 'memberIds'])
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && trimmedNonEmpty(request.resource.data.name)
        // Flutter limits grapheme clusters; the broader rules cap accommodates multi-scalar characters.
        && request.resource.data.name.size() <= 960
        && trimmedString(request.resource.data.description)
        && request.resource.data.description.size() <= 8000
        && validRecurringEventSettings(request.resource.data.recurringEventSettings)
        && request.resource.data.maxPlayersDefault is int
        && request.resource.data.maxPlayersDefault >= 2;
      allow update: if googleUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid]);
      allow delete: if false;
    }

    match /events/{eventId} {
      // The event document is public to support anonymous browsing and shared links.
      allow get, list: if true;
      allow create: if googleUser()
        && request.resource.data.keys().hasAll([
          'groupId', 'organizerId', 'organizerName', 'title', 'sport', 'city', 'district', 'description',
          'existingPlayers', 'startTime', 'endTime', 'venue', 'cost',
          'costMode', 'organizerPlaying', 'maxPlayers', 'attendeeCount',
          'waitlistCount', 'status', 'isRecurring'
        ])
        && request.resource.data.keys().hasOnly([
          'groupId', 'organizerId', 'organizerName', 'title', 'sport', 'city', 'district', 'description',
          'existingPlayers', 'startTime', 'endTime', 'venue', 'cost',
          'costMode', 'organizerPlaying', 'maxPlayers', 'attendeeCount',
          'waitlistCount', 'status', 'isRecurring'
        ])
        && request.resource.data.organizerId == request.auth.uid
        // 主揪暱稱公開顯示在場次上，必須等於主揪自己的暱稱，避免冒名。
        && request.resource.data.organizerName == ownName()
        && request.resource.data.groupId is string
        && (request.resource.data.groupId == '' || (
          exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
          && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.adminId == request.auth.uid
        ))
        && request.resource.data.sport in ['basketball', 'badminton']
        // 活動名稱選填：可為空字串，最多 40 字，前後不得有空白。
        && trimmedString(request.resource.data.title)
        && request.resource.data.title.size() <= 40
        && trimmedNonEmpty(request.resource.data.city)
        && trimmedNonEmpty(request.resource.data.district)
        // 地區全名必須以縣市開頭，且後面還有鄉鎮市區，例如「臺北市」+「大安區」。
        && request.resource.data.district.matches(request.resource.data.city + '.+')
        && trimmedString(request.resource.data.description)
        && trimmedNonEmpty(request.resource.data.venue)
        && request.resource.data.startTime is timestamp
        && request.resource.data.startTime > request.time
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.cost is int
        && request.resource.data.cost >= 0
        && request.resource.data.costMode in ['perPerson', 'totalVenue']
        && request.resource.data.organizerPlaying is bool
        && request.resource.data.existingPlayers is int
        && request.resource.data.existingPlayers >= (request.resource.data.organizerPlaying ? 1 : 0)
        && request.resource.data.maxPlayers is int
        && request.resource.data.maxPlayers >= 2
        && request.resource.data.existingPlayers <= request.resource.data.maxPlayers
        && request.resource.data.attendeeCount == 0
        && request.resource.data.waitlistCount == 0
        && request.resource.data.status == 0
        && request.resource.data.isRecurring == false;
      // 編輯場次經由 Cloud Function updateEvent（需在後端遞補候補），不開放前端直接寫入。
      allow update: if googleUser()
        && (
          eventOpen()
            && (
              notOrganizerPlaying()
                && !exists(participantPath(request.auth.uid))
                && (joinAttendee() || joinWaitlisted())
              || organizerCancel()
            )
          // 改暱稱時同步自己發布過的場次（含已結束、已取消），所以不要求場次仍開放。
          || organizerRename()
        );
      allow delete: if false;
      match /participants/{participantId} {
        allow get: if googleUser()
          && (request.auth.uid == participantId || eventOrganizer(request.auth.uid));
        allow list: if googleUser() && eventOrganizer(request.auth.uid);
        allow create: if googleUser()
          && request.auth.uid == participantId
          && request.resource.data.keys().hasAll(['eventId', 'userId', 'status', 'joinedAt', 'displayName'])
          && request.resource.data.keys().hasOnly(['eventId', 'userId', 'status', 'joinedAt', 'displayName'])
          && request.resource.data.eventId == eventId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.joinedAt == request.time
          && request.resource.data.displayName == ownName()
          && (
            request.resource.data.status == 'attending'
              && eventHasJoined(request.auth.uid, 'attending')
            || request.resource.data.status == 'waitlisted'
              && eventHasJoined(request.auth.uid, 'waitlisted')
          );
        // 本人改暱稱時同步名單上的暱稱；只能改 displayName，且必須等於（同批寫入後的）自己的暱稱。
        allow update: if googleUser()
          && request.auth.uid == participantId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          && request.resource.data.displayName == ownName();
        allow delete: if false;
      }

      // 報名者自己的暱稱；用 getAfter 讓「改暱稱＋同步名單」可以在同一批寫入完成。
      function ownName() {
        return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.name;
      }

      function eventPath() {
        return /databases/$(database)/documents/events/$(eventId);
      }

      function participantPath(uid) {
        return /databases/$(database)/documents/events/$(eventId)/participants/$(uid);
      }

      function eventOrganizer(uid) {
        return get(eventPath()).data.organizerId == uid;
      }

      function eventOpen() {
        return resource.data.status == 0
          && resource.data.startTime is timestamp
          && resource.data.endTime is timestamp
          && resource.data.startTime > request.time
          && resource.data.endTime > resource.data.startTime;
      }

      function notOrganizerPlaying() {
        return !(resource.data.organizerPlaying && resource.data.organizerId == request.auth.uid);
      }

      function onlyCounter(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      function eventHasJoined(uid, status) {
        let event = get(eventPath()).data;
        let after = getAfter(eventPath()).data;
        return event.status == 0
          && event.startTime is timestamp
          && event.endTime is timestamp
          && event.startTime > request.time
          && event.endTime > event.startTime
          && !(event.organizerPlaying && event.organizerId == uid)
          && !exists(participantPath(uid))
          && (
            status == 'attending'
              && event.existingPlayers + event.attendeeCount < event.maxPlayers
              && after.attendeeCount == event.attendeeCount + 1
              && after.waitlistCount == event.waitlistCount
            || status == 'waitlisted'
              && event.existingPlayers + event.attendeeCount >= event.maxPlayers
              && after.attendeeCount == event.attendeeCount
              && after.waitlistCount == event.waitlistCount + 1
          );
      }

      // 主揪在開始前取消整場：只能把狀態改成已取消（2），並記錄伺服器時間。
      function organizerCancel() {
        return resource.data.organizerId == request.auth.uid
          && onlyCounter(['status', 'cancelledAt'])
          && request.resource.data.status == 2
          && request.resource.data.cancelledAt == request.time;
      }

      function organizerRename() {
        return resource.data.organizerId == request.auth.uid
          && onlyCounter(['organizerName'])
          && request.resource.data.organizerName == ownName();
      }

      function joinAttendee() {
        return onlyCounter(['attendeeCount'])
          && request.resource.data.attendeeCount == resource.data.attendeeCount + 1
          && getAfter(participantPath(request.auth.uid)).data.status == 'attending';
      }

      function joinWaitlisted() {
        return onlyCounter(['waitlistCount'])
          && request.resource.data.waitlistCount == resource.data.waitlistCount + 1
          && getAfter(participantPath(request.auth.uid)).data.status == 'waitlisted';
      }
    }

    match /{path=**}/participants/{participantId} {
      allow list: if googleUser() && resource.data.userId == request.auth.uid;
    }
  }
}
